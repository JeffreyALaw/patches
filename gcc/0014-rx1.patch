+      {
+	if (! rx_call_operand (dest, Pmode))
+	  dest = force_reg (Pmode, dest);
+	emit_call_insn (gen_call_internal (dest));
+      }
+    else
+      {
+	rtx savereg = gen_reg_rtx (Pmode);
