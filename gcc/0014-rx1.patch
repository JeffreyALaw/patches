+(define_insn "call_value_internal_plt"
+  [(set (match_operand		     0 "register_operand" "=r")
+	(call (mem:QI (match_operand 1 "rx_plt_call_operand" ""))
+	      (const_int 0)))
+   (clobber (reg:CC CC_REG))
