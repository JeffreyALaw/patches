+/* Implement TARGET_DELEGITIMIZE_ADDRESS.  */
+static rtx
+rx_delegitimize_address (rtx x)
+{
+  x = delegitimize_mem_from_attrs (x);
+  if (rx_pcrel_label_operand (x, Pmode))
+    return XVECEXP (XEXP (x, 0), 0, 0);
+
+  return x;
