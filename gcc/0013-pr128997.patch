diff --git a/gcc/cse.cc b/gcc/cse.cc
index 185c2f530074..d39529436531 100644
--- a/gcc/cse.cc
+++ b/gcc/cse.cc
@@ -2907,7 +2907,14 @@ canon_reg (rtx x, rtx_insn *insn)
 
 	    if (validate_subreg (GET_MODE (x), GET_MODE (inner),
 				 inner, SUBREG_BYTE (x)))
-	      validate_change (insn, &SUBREG_REG (x), inner, 1);
+	      {
+	 	/* This is going to re-use the existing SUBREG
+		   expression, but the substitution may make the
+		   previously known promotion state invalid.  */
+	        validate_change (insn, &SUBREG_REG (x), inner, 1);
+		if (GET_CODE (x) == SUBREG)
+		  SUBREG_PROMOTED_VAR_P (x) = 0;
+	      }
 	  }
 	return x;
       }
diff --git a/gcc/testsuite/gcc.dg/torture/pr128997.c b/gcc/testsuite/gcc.dg/torture/pr128997.c
new file mode 100644
index 000000000000..560169fd960f
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/torture/pr128997.c
@@ -0,0 +1,19 @@
+/* { dg-do run { target int128 } } */
+
+int j, m;
+__int128 g;
+signed char v;
+int main(void) {
+  short x = 0;
+  if (!j)
+    g = 1 << 16;
+  for (; j; j++) {
+    v = m || x;
+    if (g == v)
+      x = v;
+  }
+  if ((int)(g >> 16) == 0)
+    __builtin_abort ();
+  __builtin_exit (0);
+}
+
