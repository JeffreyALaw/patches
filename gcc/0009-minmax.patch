--- a/gcc/match.pd
+++ b/gcc/match.pd
@@ -14019,3 +14019,13 @@
    (if (min_prec0 + min_prec1 - 1 <= TYPE_PRECISION (TREE_TYPE (@0)))
     (complex (IFN_CLMUL @0 @1) { build_zero_cst (TREE_TYPE (@0)); })))))
 #endif
+
+/* c ? (T) x * C : 0  ->  (T) min/max (x, 0) * C   when c compares x against
+   zero.  (T) min (x, 0) is (T) x when x < 0 and 0 otherwise, so the multiply
+   sees the same value as in the select for any conversion.  */
+(for cmp (lt le gt ge)
+     minmax (min min max max)
+ (simplify
+  (cond (cmp @1 integer_zerop) (mult (convert? @1) @3) integer_zerop)
+  (if (INTEGRAL_TYPE_P (type) && INTEGRAL_TYPE_P (TREE_TYPE (@1)))
+   (mult (convert (minmax @1 { build_zero_cst (TREE_TYPE (@1)); })) @3))))
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/tree-ssa/select-minmax-1.c
@@ -0,0 +1,35 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -fdump-tree-optimized" } */
+/* { dg-require-effective-target lp64 } */
+
+/* A select of a conversion of X times a value, guarded by a comparison of X
+   with zero, is the same product applied to min (X, 0) or max (X, 0).  The
+   front end folds this when the select is written as ?:.  */
+
+unsigned long
+f_lt (long x)
+{
+  return x < 0 ? (unsigned long) x * 7 : 0;
+}
+
+unsigned long
+f_le (long x)
+{
+  return x <= 0 ? (unsigned long) x * 7 : 0;
+}
+
+unsigned long
+f_gt (long x)
+{
+  return x > 0 ? (unsigned long) x * 7 : 0;
+}
+
+unsigned long
+f_ge (long x)
+{
+  return x >= 0 ? (unsigned long) x * 7 : 0;
+}
+
+/* { dg-final { scan-tree-dump-times "MIN_EXPR" 2 "optimized" } } */
+/* { dg-final { scan-tree-dump-times "MAX_EXPR" 2 "optimized" } } */
+/* { dg-final { scan-tree-dump-not " \\? " "optimized" } } */
