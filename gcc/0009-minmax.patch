diff --git a/gcc/testsuite/gcc.dg/tree-ssa/minmax-cmp-1.c b/gcc/testsuite/gcc.dg/tree-ssa/minmax-cmp-1.c
new file mode 100644
index 00000000000..f5be4965c02
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/tree-ssa/minmax-cmp-1.c
@@ -0,0 +1,27 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -fdump-tree-optimized" } */
+
+/* Two comparisons against the same value, combined with & or |, become one
+   comparison of a MIN/MAX, including when the common operand is a constant
+   (as in the vectorizer's runtime alias check).  */
+
+#define FORMS(T, N) \
+  int and_gt_##N (T a, T b) { return (a >  4) & (b >  4); } \
+  int and_ge_##N (T a, T b) { return (a >= 4) & (b >= 4); } \
+  int and_lt_##N (T a, T b) { return (a <  4) & (b <  4); } \
+  int and_le_##N (T a, T b) { return (a <= 4) & (b <= 4); } \
+  int ior_gt_##N (T a, T b) { return (a >  4) | (b >  4); } \
+  int ior_ge_##N (T a, T b) { return (a >= 4) | (b >= 4); } \
+  int ior_lt_##N (T a, T b) { return (a <  4) | (b <  4); } \
+  int ior_le_##N (T a, T b) { return (a <= 4) | (b <= 4); }
+
+FORMS (int, i)
+FORMS (unsigned int, u)
+FORMS (long, l)
+FORMS (unsigned long, ul)
+
+/* Per type: and_gt, and_ge, ior_lt, ior_le use MIN; the other four MAX.  */
+/* { dg-final { scan-tree-dump-times " = MIN_EXPR <" 16 "optimized" } } */
+/* { dg-final { scan-tree-dump-times " = MAX_EXPR <" 16 "optimized" } } */
+/* { dg-final { scan-tree-dump-not " & " "optimized" } } */
+/* { dg-final { scan-tree-dump-not " \\| " "optimized" } } */
diff --git a/gcc/testsuite/gcc.dg/tree-ssa/minmax-cmp-2.c b/gcc/testsuite/gcc.dg/tree-ssa/minmax-cmp-2.c
new file mode 100644
index 00000000000..278f32d4e5b
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/tree-ssa/minmax-cmp-2.c
@@ -0,0 +1,14 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -fdump-tree-optimized" } */
+
+/* Operands of different types or signedness must not be combined.  */
+
+int f1 (long l, int i) { return (l > 4) & (i > 4); }
+int f2 (unsigned u, int i) { return (u > 4) & (i > 4); }
+int f3 (signed char c, unsigned short s) { return (c > 4) & (s > 4); }
+int f4 (int a, unsigned b) { return (a > 4) & (b > 4u); }
+int f5 (int a, int b, int c) { return (a > 4) & (b > c); }
+int f6 (int a, int b) { return (a > 4) & (b < 4); }
+
+/* { dg-final { scan-tree-dump-not "MIN_EXPR" "optimized" } } */
+/* { dg-final { scan-tree-dump-not "MAX_EXPR" "optimized" } } */
diff --git a/gcc/testsuite/gcc.target/riscv/zbb-min-max-cmp-1.c b/gcc/testsuite/gcc.target/riscv/zbb-min-max-cmp-1.c
