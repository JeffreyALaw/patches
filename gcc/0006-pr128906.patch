diff --git a/gcc/testsuite/gcc.target/h8300/pr128906-2.c b/gcc/testsuite/gcc.target/h8300/pr128906-2.c
new file mode 100644
index 000000000000..6e3f93509e97
--- /dev/null
+++ b/gcc/testsuite/gcc.target/h8300/pr128906-2.c
@@ -0,0 +1,10 @@
+/* The inverted variants of *store_z_<mode>_and used to emit "X0" instead of
+   "%X0" as the bist operand.  */
+/* { dg-do compile }  */
+/* { dg-options "-mh -O2" }  */
+
+int  and_hi_ne (int a, int b, int c)    { return (a != b) & c; }
+long and_si_ne (long a, long b, long c) { return (a != b) & c; }
+
+/* { dg-final { scan-assembler-times "bist\t#0,r0l" 2 } }  */
+/* { dg-final { scan-assembler-not "X0" } }  */
diff --git a/gcc/testsuite/gcc.target/h8300/pr128906.c b/gcc/testsuite/gcc.target/h8300/pr128906.c
new file mode 100644
index 000000000000..7f270678e1f2
--- /dev/null
+++ b/gcc/testsuite/gcc.target/h8300/pr128906.c
@@ -0,0 +1,14 @@
+/* { dg-do compile }  */
+/* { dg-options "-mh -O2 -dp" }  */
+
+long z_si (long a, long b)       { return a != b; }
+long sb_si (long a, long b)      { return (long)(a != b) << 15; }
+long neg_si (long a, long b)     { return -(a != b); }
+long and_si (long a, long b, long c) { return (a != b) & c; }
+int and_hi (int a, int b, int c) { return (a != b) & c; }
+
+/* { dg-final { scan-assembler "l=10\\\]\[ \t\]+\\*store_z_si\\M" } }  */
+/* { dg-final { scan-assembler "l=10\\\]\[ \t\]+\\*store_z_si_sb\\M" } }  */
