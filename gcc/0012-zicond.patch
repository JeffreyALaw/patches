diff --git a/gcc/config/riscv/zicond.md b/gcc/config/riscv/zicond.md
index b07aec8feb2..7409ce4c66f 100644
--- a/gcc/config/riscv/zicond.md
+++ b/gcc/config/riscv/zicond.md
@@ -536,3 +536,106 @@
 				      (const_int 0)))
    (set (match_dup 0) (ior:X (match_dup 4) (match_dup 3)))])
 
+
+;; Selecting between X and 0 on a sign test.  A GE against zero is not
+;; something czero can test directly, but x >= 0 is !(x < 0), so use slti
+;; to get x < 0 and the czero of the opposite sense.  Putting the test in
+;; LT form also lets it be shared with other users of x < 0.
+(define_split
+  [(set (match_operand:X 0 "register_operand")
+	(if_then_else:X (ge:X (match_operand:X 1 "register_operand")
+			      (const_int 0))
+			(match_operand:X 2 "register_operand")
+			(const_int 0)))]
+  "TARGET_ZICOND && can_create_pseudo_p ()"
+  [(set (match_dup 3) (lt:X (match_dup 1) (const_int 0)))
+   (set (match_dup 0) (if_then_else:X (eq:X (match_dup 3) (const_int 0))
+				      (match_dup 2)
+				      (const_int 0)))]
+  { operands[3] = gen_reg_rtx (<MODE>mode); })
+
+(define_split
+  [(set (match_operand:X 0 "register_operand")
+	(if_then_else:X (ge:X (match_operand:X 1 "register_operand")
+			      (const_int 0))
+			(const_int 0)
+			(match_operand:X 2 "register_operand")))]
+  "TARGET_ZICOND && can_create_pseudo_p ()"
+  [(set (match_dup 3) (lt:X (match_dup 1) (const_int 0)))
+   (set (match_dup 0) (if_then_else:X (ne:X (match_dup 3) (const_int 0))
+				      (match_dup 2)
+				      (const_int 0)))]
+  { operands[3] = gen_reg_rtx (<MODE>mode); })
+
+;; A condition (C ^ 1) where C is known to be 0 or 1 is true exactly when C
+;; is zero, so the XOR is not needed.  The arm is computed unconditionally
+;; and the czero does the selection.
+(define_code_iterator zicond_binop [plus minus ior xor and])
+(define_code_attr zicond_binop_pred [(plus "arith_operand")
+				     (minus "register_operand")
+				     (ior "arith_operand")
+				     (xor "arith_operand")
+				     (and "arith_operand")])
+
+(define_split
+  [(set (match_operand:X 0 "register_operand")
+	(if_then_else:X (xor:X (match_operand:X 1 "register_operand")
+			       (const_int 1))
+			(zicond_binop:X (match_operand:X 2 "register_operand")
+					(match_operand:X 3 "<zicond_binop_pred>"))
+			(const_int 0)))]
+  "TARGET_ZICOND
+   && nonzero_bits (operands[1], word_mode) == 1
+   && can_create_pseudo_p ()"
+  [(set (match_dup 4) (zicond_binop:X (match_dup 2) (match_dup 3)))
+   (set (match_dup 0) (if_then_else:X (eq:X (match_dup 1) (const_int 0))
+				      (match_dup 4)
+				      (const_int 0)))]
+  { operands[4] = gen_reg_rtx (<MODE>mode); })
+
+;; With the arms the other way around, combine simplifies the condition
+;; (C ^ 1) == 0 to a bare C.
+(define_split
+  [(set (match_operand:X 0 "register_operand")
+	(if_then_else:X (match_operand:X 1 "register_operand")
+			(zicond_binop:X (match_operand:X 2 "register_operand")
+					(match_operand:X 3 "<zicond_binop_pred>"))
+			(const_int 0)))]
+  "TARGET_ZICOND && can_create_pseudo_p ()"
+  [(set (match_dup 4) (zicond_binop:X (match_dup 2) (match_dup 3)))
+   (set (match_dup 0) (if_then_else:X (ne:X (match_dup 1) (const_int 0))
+				      (match_dup 4)
+				      (const_int 0)))]
+  { operands[4] = gen_reg_rtx (<MODE>mode); })
+
+;; Shifts and rotates need their own splits as the count is QImode.
+(define_split
+  [(set (match_operand:X 0 "register_operand")
+	(if_then_else:X (xor:X (match_operand:X 1 "register_operand")
+			       (const_int 1))
+			(any_shift_rotate:X
+			  (match_operand:X 2 "register_operand")
+			  (match_operand:QI 3 "arith_operand"))
+			(const_int 0)))]
+  "TARGET_ZICOND
+   && nonzero_bits (operands[1], word_mode) == 1
+   && can_create_pseudo_p ()"
+  [(set (match_dup 4) (any_shift_rotate:X (match_dup 2) (match_dup 3)))
+   (set (match_dup 0) (if_then_else:X (eq:X (match_dup 1) (const_int 0))
+				      (match_dup 4)
+				      (const_int 0)))]
+  { operands[4] = gen_reg_rtx (<MODE>mode); })
+
+(define_split
+  [(set (match_operand:X 0 "register_operand")
+	(if_then_else:X (match_operand:X 1 "register_operand")
+			(any_shift_rotate:X
+			  (match_operand:X 2 "register_operand")
+			  (match_operand:QI 3 "arith_operand"))
+			(const_int 0)))]
+  "TARGET_ZICOND && can_create_pseudo_p ()"
+  [(set (match_dup 4) (any_shift_rotate:X (match_dup 2) (match_dup 3)))
+   (set (match_dup 0) (if_then_else:X (ne:X (match_dup 1) (const_int 0))
+				      (match_dup 4)
+				      (const_int 0)))]
+  { operands[4] = gen_reg_rtx (<MODE>mode); })
diff --git a/gcc/testsuite/gcc.target/riscv/zicond-ge-select.c b/gcc/testsuite/gcc.target/riscv/zicond-ge-select.c
new file mode 100644
index 00000000000..77000e902ff
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/zicond-ge-select.c
@@ -0,0 +1,47 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv64gc_zicond -mabi=lp64d -fgimple" } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" } } */
+
+/* A select on S >= 0 is expanded as (~S) >> 63, which costs two
+   instructions.  Testing S < 0 with slti and using the czero of the other
+   sense costs one.  */
+
+long
+__GIMPLE (ssa,startwith ("optimized"))
+f_nez (long s, long a)
+{
+  _Bool c;
+  long t;
+
+  __BB(2):
+  c_3 = s_1(D) >= 0l;
+  t_4 = c_3 ? a_2(D) : 7l;
+  return t_4;
+}
+
+/* With the arms reversed combine merges the select into
+   (if_then_else (lt s 0) ...), which is not recognized, so the not/srli
+   sequence remains.  */
+long
+__GIMPLE (ssa,startwith ("optimized"))
+f_eqz (long s, long a)
+{
+  _Bool c;
+  long t;
+
+  __BB(2):
+  c_3 = s_1(D) >= 0l;
+  t_4 = c_3 ? 7l : a_2(D);
+  return t_4;
+}
+
+/* f_nez uses czero.nez and f_eqz uses czero.eqz, each with one slti and an
+   addi pair around it.  These counts need both functions, so they fail
+   until f_eqz is handled.  */
+/* { dg-final { scan-assembler-times "\tslti\t\[axt\]\[0-9\],\[axt\]\[0-9\],0" 2 { xfail *-*-* } } } */
+/* { dg-final { scan-assembler-times "\taddi\t\[axt\]\[0-9\],\[axt\]\[0-9\],-7" 2 } } */
+/* { dg-final { scan-assembler-times "\tczero\.nez\t" 1 { xfail *-*-* } } } */
+/* { dg-final { scan-assembler-times "\tczero\.eqz\t" 1 { xfail *-*-* } } } */
+/* { dg-final { scan-assembler-times "\taddi\t\[axt\]\[0-9\],\[axt\]\[0-9\],7" 2 } } */
+/* { dg-final { scan-assembler-not "\tnot\t" { xfail *-*-* } } } */
+/* { dg-final { scan-assembler-not "\tsrli\t" { xfail *-*-* } } } */
