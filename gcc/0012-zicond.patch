+
+;; Selecting between X and 0 on a sign test.  A GE against zero is not
+;; something czero can test directly, but x >= 0 is !(x < 0), so use slti
+;; to get x < 0 and the czero of the opposite sense.  Putting the test in
+;; LT form also lets it be shared with other users of x < 0.
+(define_split
+  [(set (match_operand:X 0 "register_operand")
+	(if_then_else:X (ge:X (match_operand:X 1 "register_operand")
+			      (const_int 0))
+			(match_operand:X 2 "reg_or_0_operand")
+			(match_operand:X 3 "reg_or_0_operand")))
+   (clobber (match_operand:X 4 "register_operand"))]
+  "(TARGET_ZICOND
+    && (operands[2] == CONST0_RTX (word_mode)
+	|| operands[3] == CONST0_RTX (word_mode)))"
+  [(set (match_dup 4) (lt:X (match_dup 1) (const_int 0)))
+   (set (match_dup 0) (if_then_else:X (match_dup 5)
+				      (match_dup 2)
+				      (match_dup 3)))]
+  { 
+    rtx_code code = EQ;
+    if (operands[3] != CONST0_RTX (word_mode))
+      {
+        std::swap (operands[2], operands[3]);
+	code = NE;
+      }
+
+    operands[5] = gen_rtx_fmt_ee (code, word_mode,
+				  operands[4], CONST0_RTX (word_mode));
+  })
