diff --git a/gcc/config/h8300/h8300.cc b/gcc/config/h8300/h8300.cc
index ad714f57d660..1598a86996e3 100644
--- a/gcc/config/h8300/h8300.cc
+++ b/gcc/config/h8300/h8300.cc
@@ -4340,8 +4340,11 @@ compute_a_shift_length (rtx operands[3], rtx_code code)
 	  /* Fall through.  */
 
 	case SHIFT_INLINE:
-	  /* H8/SX has a richer set of logical shifts.  */
+	  /* H8/SX has a richer set of logical shifts, but do not
+	     override the length computation if we're using a SHIFT_SPECIAL
+	     sequence as those may not exploit the H8/SX special shifts.  */
 	  if (TARGET_H8300SX
+	      && info.alg == SHIFT_SPECIAL
 	      && (code == ASHIFT || code == LSHIFTRT))
 	    return (exact_log2 (n) >= 0) ? 2 : 4;
 
diff --git a/gcc/config/h8300/logical.md b/gcc/config/h8300/logical.md
index 9550943fbcbb..dfcf906e08e3 100644
--- a/gcc/config/h8300/logical.md
+++ b/gcc/config/h8300/logical.md
@@ -349,3 +349,20 @@ (define_peephole2
    (parallel [(set (zero_extract:SI (match_dup 0) (const_int 8) (const_int 8))
 		   (lshiftrt:SI (match_dup 1) (const_int 8)))
 	      (clobber (reg:CC CC_REG))])])
+
+;; The two register form for PLUS is smaller and faster than the IOR or
+;; XOR forms for SImode
+(define_expand "aopsi3"
+  [(set (match_operand:SI 0 "register_operand")
+	(ior:SI (match_operand:SI 1 "register_operand")
+                (match_operand:SI 2 "h8300_src_operand")))]
+  ""
+  {
+    if (REG_P (operands[2]))
+      emit_insn (gen_addsi3 (operands[0], operands[1], operands[2]));
+    else
+      emit_insn (gen_iorsi3 (operands[0], operands[1], operands[2]));
+    DONE;
+  }
+)
+
