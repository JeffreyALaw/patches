index 00000000000..02ef91a22bc
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/xor-synthesis-5.c
@@ -0,0 +1,10 @@
+/* { dg-do compile { target rv64 } } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" } } */
+/* { dg-options "-march=rv64gc_zbkb -mabi=lp64d" } */
