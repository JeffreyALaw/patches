 .../arm/postreload-implicit-set-1.c           | 57 +++++++++++++++++++
 .../arm/postreload-implicit-set-2.c           | 34 +++++++++++
 .../i386/postreload-implicit-set-1.c          | 27 +++++++++
 5 files changed, 188 insertions(+), 10 deletions(-)
