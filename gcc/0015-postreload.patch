+
+/*
+** nonzero:
+**	cmp	r0, #7
+**	beq	\.L[0-9]+
+**	push	{r3, lr}
+**	bl	g
+**	cmp	r0, #7
+**	beq	\.L[0-9]+
+**	pop	{r3, lr}
+**	b	h
+**	pop	{r3, pc}
+**	bx	lr
+*/
+int
+nonzero (int x)
+{
+  if (x == 7)
