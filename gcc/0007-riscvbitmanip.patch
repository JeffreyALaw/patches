diff --git a/gcc/config/riscv/bitmanip.md b/gcc/config/riscv/bitmanip.md
index 1027aa2dc066..a458e3e9d876 100644
--- a/gcc/config/riscv/bitmanip.md
+++ b/gcc/config/riscv/bitmanip.md
@@ -1616,6 +1616,11 @@ (define_insn "rotate_with_masking_to_shift"
 ;; I started to to implement this in simplify-rtx.cc, but the interactions
 ;; with combine were complex.  It would likely still be helpful, particularly
 ;; on targets with single bit manipulations similar to RISC-V
+;;
+;; Note that we know the input register has 33+ sign bits.  The split RTL
+;; does not modify bits 32..63 (they're outside SImode).  So as long as we
+;; do not touch bit 31 we're safe (from the standpoint of bits 32..63 staying
+;; sign bit copies).
 (define_split
   [(set (match_operand:DI 0 "register_operand")
 	(sign_extend:DI
@@ -1624,15 +1629,27 @@ (define_split
 		  (match_operand 3 "const_int_operand"))))]
   "(TARGET_ZBS
     && (UINTVAL (operands[2]) & UINTVAL (operands[3])) == 0
-    && popcount_hwi (~(UINTVAL (operands[2]) | UINTVAL (operands[3]))) == 1
+    /* We don't care about bits 32..63 for this test, we want the new mask to
+       just have one bit off so that it's suitable for bclri.  */
+    && popcount_hwi (~(UINTVAL (operands[2]) | UINTVAL (operands[3])) & 0xffffffff) == 1
     && num_sign_bit_copies (operands[1], DImode) >= 33
-    /* Be careful with the SI sign bit.  We're relying on not changing the
-       sign bit or the extension in this transformation.  */
-    && ((UINTVAL (operands[2]) & HOST_WIDE_INT_C (0xffffffff80000000))
-	== HOST_WIDE_INT_C (0xffffffff80000000))
-    && ((UINTVAL (operands[3]) & HOST_WIDE_INT_C (0xffffffff80000000))
-	== 0))"
+    /* Make sure the AND does not modify the sign bit.  */
+    && ((UINTVAL (operands[2]) & HOST_WIDE_INT_UC (0x80000000))
+	== HOST_WIDE_INT_UC (0x80000000))
+    /* Make sure the IOR does not change the SI sign bit.  The rest of the
+       bits tested are just paranoia.  */
+    && ((UINTVAL (operands[3]) & HOST_WIDE_INT_C (0xffffffff80000000)) == 0))"
   [(set (match_dup 0) (and:DI (match_dup 1) (match_dup 2)))
    (set (match_dup 0) (ior:DI (match_dup 0) (match_dup 3)))]
-  { operands[2] = GEN_INT (UINTVAL (operands[2]) | UINTVAL (operands[3])); })
+  { 
+    unsigned HOST_WIDE_INT new_mask = UINTVAL (operands[2]);
+
+    /* Turn on the bit(s) that the OXP turns on.  */
+    new_mask |= UINTVAL (operands[3]);
+
+    /* Turn on the upper 33 bits on the AND mask.  That is safe given the
+       tests above and results in constants that more likel satisfy bclri.  */
+    new_mask |= HOST_WIDE_INT_UC (0xffffffff80000000);
+    operands[2] = GEN_INT (new_mask);
+  })
   
diff --git a/gcc/simplify-rtx.cc b/gcc/simplify-rtx.cc
index 6b19008c0d32..227e69447fbb 100644
--- a/gcc/simplify-rtx.cc
+++ b/gcc/simplify-rtx.cc
@@ -3409,6 +3409,47 @@ simplify_context::simplify_binary_operation_1 (rtx_code code,
 				    simplify_gen_binary (XOR, mode, op1,
 							 XEXP (op0, 1)));
 
+      /* (x & C1) + ((x ^ y) & C2) is x ^ (y & C2) when ~C1 == C2.
+	 Note that what we see in practice is op0 and op1 being lowpart
+	 subregs.  */
+      if (GET_CODE (op0) == SUBREG
+	  && GET_CODE (op1) == SUBREG
+	  && subreg_lowpart_p (op0)
+	  && subreg_lowpart_p (op1)
+	  && GET_CODE (SUBREG_REG (op0)) == AND
+	  && GET_CODE (SUBREG_REG (op1)) == AND
+	  && CONST_INT_P (XEXP (SUBREG_REG (op0), 1))
+	  && CONST_INT_P (XEXP (SUBREG_REG (op1), 1))
+	  && (~UINTVAL (XEXP (SUBREG_REG (op0), 1))
+	      == UINTVAL (XEXP (SUBREG_REG (op1), 1))))
+	{
+	  rtx temp_op0 = XEXP (SUBREG_REG (op0), 0);
+	  rtx temp_op1 = XEXP (SUBREG_REG (op1), 0);
+	  if (GET_CODE (temp_op0) == XOR)
+	    std::swap (temp_op0, temp_op1);
+
+	  /* While TOP0 could be anything without side effects,
+	     it seems safer to restrict to REGs.  */
+	  if (REG_P (temp_op0) && GET_CODE (temp_op1) == XOR)
+	    {
+	      rtx new_op0 = NULL_RTX;
+	      rtx new_op1 = NULL_RTX;
+	      if (temp_op0 == XEXP (temp_op1, 0))
+		new_op0 = temp_op0, new_op1 = XEXP (temp_op1, 1);
+	      else if (temp_op0 == XEXP (temp_op1, 1))
+		new_op0 = temp_op0, new_op1 = XEXP (temp_op1, 0);
+
+	      if (new_op0 && new_op1)
+		{
+		  machine_mode op_mode = GET_MODE (new_op1);
+		  rtx x = gen_rtx_AND (op_mode, new_op1, XEXP (SUBREG_REG (op1), 1));
+		  x = gen_rtx_XOR (op_mode, new_op0, x);
+		  poly_int64 offset = subreg_lowpart_offset (mode, op_mode);
+		  return simplify_gen_subreg (mode, x, op_mode, offset);
+		}
+	    }
+	}
+
       /* Canonicalize (plus (mult (neg B) C) A) to (minus A (mult B C)).  */
       if (!HONOR_SIGN_DEPENDENT_ROUNDING (mode)
 	  && GET_CODE (op0) == MULT
