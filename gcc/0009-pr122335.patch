@@ -0,0 +1,14 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv64gcb_zicond -mabi=lp64d -O2" { target { rv64 } } } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" "-O1" "-Os" "-O3" "-Oz" } } */
+int test_05_3 (int x)
+{
+  return x > 0 ? x + 1 : x;
+}
+
+int mirror (int x)
+{
+  return x <= 0 ? x : x + 1;
+}
+/* { dg-final { scan-assembler-times "sgt" 2 } } */
+/* { dg-final { scan-assembler-not "czero" } } */
diff --git a/gcc/testsuite/gcc.target/riscv/pr122335-2.c b/gcc/testsuite/gcc.target/riscv/pr122335-2.c
new file mode 100644
index 00000000000..88a1f2daf9a
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/pr122335-2.c
@@ -0,0 +1,11 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv64gcb_zicond -mabi=lp64d -O2 -g" { target { rv64 } } } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" "-O1" "-Os" "-O3" "-Oz" } } */
+int f (int x)
+{
+  int r;
+  if (x > 0) { int t = x + 1; r = t; } else r = x;
+  return r;
+}
