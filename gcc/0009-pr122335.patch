 gcc/testsuite/gcc.target/riscv/pr122335-1.c | 14 +++++++++++
 gcc/testsuite/gcc.target/riscv/pr122335-2.c | 11 +++++++++
 3 files changed, 50 insertions(+), 2 deletions(-)
 create mode 100644 gcc/testsuite/gcc.target/riscv/pr122335-1.c
