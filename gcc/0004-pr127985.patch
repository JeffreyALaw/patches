diff --git a/gcc/testsuite/gcc.dg/torture/pr127985.c
b/gcc/testsuite/gcc.dg/torture/pr127985.c
new file mode 100644
index 00000000000..0ebdc47b2b4
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/torture/pr127985.c
@@ -0,0 +1,122 @@
+/* PR tree-optimization/127985 */
+/* { dg-do run } */
+
+#include <stdint.h>
+
+__attribute__((noipa)) int8_t
+dec_i8 (int8_t x)
+{
+  return x == INT8_MIN ? INT8_MIN : x - 1;
+}
+
+__attribute__((noipa)) int16_t
+dec_i16 (int16_t x)
+{
+  return x == INT16_MIN ? INT16_MIN : x - 1;
+}
+
+__attribute__((noipa)) int32_t
+dec_i32 (int32_t x)
+{
+  return x == INT32_MIN ? INT32_MIN : x - 1;
+}
+
+__attribute__((noipa)) int64_t
+dec_i64 (int64_t x)
+{
+  return x == INT64_MIN ? INT64_MIN : x - 1;
+}
+
+__attribute__((noipa)) int8_t
+dec_ne_i8 (int8_t x)
+{
+  return x != INT8_MIN ? x - 1 : INT8_MIN;
+}
+
+__attribute__((noipa)) int16_t
+dec_ne_i16 (int16_t x)
+{
+  return x != INT16_MIN ? x - 1 : INT16_MIN;
+}
+
+__attribute__((noipa)) int32_t
+dec_ne_i32 (int32_t x)
+{
+  return x != INT32_MIN ? x - 1 : INT32_MIN;
+}
+
+__attribute__((noipa)) int64_t
+dec_ne_i64 (int64_t x)
+{
+  return x != INT64_MIN ? x - 1 : INT64_MIN;
+}
+
+int
+main (void)
+{
+  if (dec_i8 (INT8_MIN) != INT8_MIN
+      || dec_i8 (INT8_MIN + 1) != INT8_MIN
+      || dec_i8 (-1) != -2
+      || dec_i8 (0) != -1
+      || dec_i8 (10) != 9
+      || dec_i8 (INT8_MAX) != INT8_MAX - 1)
+    __builtin_abort ();
+
+  if (dec_i16 (INT16_MIN) != INT16_MIN
+      || dec_i16 (INT16_MIN + 1) != INT16_MIN
+      || dec_i16 (-1) != -2
+      || dec_i16 (0) != -1
+      || dec_i16 (10) != 9
+      || dec_i16 (INT16_MAX) != INT16_MAX - 1)
+    __builtin_abort ();
+
+  if (dec_i32 (INT32_MIN) != INT32_MIN
+      || dec_i32 (INT32_MIN + 1) != INT32_MIN
+      || dec_i32 (-1) != -2
+      || dec_i32 (0) != -1
+      || dec_i32 (10) != 9
+      || dec_i32 (INT32_MAX) != INT32_MAX - 1)
+    __builtin_abort ();
+
+  if (dec_i64 (INT64_MIN) != INT64_MIN
+      || dec_i64 (INT64_MIN + 1) != INT64_MIN
+      || dec_i64 (-1) != -2
+      || dec_i64 (0) != -1
+      || dec_i64 (10) != 9
+      || dec_i64 (INT64_MAX) != INT64_MAX - 1)
+    __builtin_abort ();
+
+  if (dec_ne_i8 (INT8_MIN) != INT8_MIN
+      || dec_ne_i8 (INT8_MIN + 1) != INT8_MIN
+      || dec_ne_i8 (-1) != -2
+      || dec_ne_i8 (0) != -1
+      || dec_ne_i8 (10) != 9
+      || dec_ne_i8 (INT8_MAX) != INT8_MAX - 1)
+    __builtin_abort ();
+
+  if (dec_ne_i16 (INT16_MIN) != INT16_MIN
+      || dec_ne_i16 (INT16_MIN + 1) != INT16_MIN
+      || dec_ne_i16 (-1) != -2
+      || dec_ne_i16 (0) != -1
+      || dec_ne_i16 (10) != 9
+      || dec_ne_i16 (INT16_MAX) != INT16_MAX - 1)
+    __builtin_abort ();
+
+  if (dec_ne_i32 (INT32_MIN) != INT32_MIN
+      || dec_ne_i32 (INT32_MIN + 1) != INT32_MIN
+      || dec_ne_i32 (-1) != -2
+      || dec_ne_i32 (0) != -1
+      || dec_ne_i32 (10) != 9
+      || dec_ne_i32 (INT32_MAX) != INT32_MAX - 1)
+    __builtin_abort ();
+
+  if (dec_ne_i64 (INT64_MIN) != INT64_MIN
+      || dec_ne_i64 (INT64_MIN + 1) != INT64_MIN
+      || dec_ne_i64 (-1) != -2
+      || dec_ne_i64 (0) != -1
+      || dec_ne_i64 (10) != 9
+      || dec_ne_i64 (INT64_MAX) != INT64_MAX - 1)
+    __builtin_abort ();
+
+  return 0;
+}
