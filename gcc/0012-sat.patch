--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/rvv/autovec/sat-trunc-promote-1.c
@@ -0,0 +1,25 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv64gcv -mabi=lp64d -O3 -mrvv-max-lmul=m1 -fno-vect-cost-model -fdump-tree-optimized" } */
+
+#include <stdint-gcc.h>
+
+static inline uint8_t
+clip_uint8 (int x)
+{
+  return x & ~255 ? (-x) >> 31 : x;
+}
+
+__attribute__ ((noipa)) void
+hpel_clip (uint8_t *__restrict dst, const uint8_t *__restrict src, int n)
+{
+  for (int i = 0; i < n; ++i)
+    {
+      int value = (src[i - 2] + src[i + 3]
+		   - 5 * (src[i - 1] + src[i + 2])
+		   + 20 * (src[i] + src[i + 1]));
+      dst[i] = clip_uint8 ((value + 16) >> 5);
+    }
+}
+
+/* { dg-final { scan-tree-dump-times {\.SAT_TRUNC } 1 "optimized" } } */
+/* { dg-final { scan-assembler-times {\tvnclipu\.wi} 1 } } */
diff --git a/gcc/testsuite/gcc.target/riscv/rvv/autovec/sat-trunc-promote-run-1.c b/gcc/testsuite/gcc.target/riscv/rvv/autovec/sat-trunc-promote-run-1.c
new file mode 100644
index 00000000000..6249defff38
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/rvv/autovec/sat-trunc-promote-run-1.c
@@ -0,0 +1,45 @@
+/* { dg-do run { target { riscv_v && rv64 } } } */
+/* { dg-options "-march=rv64gcv -mabi=lp64d -O3 -mrvv-max-lmul=m1 -fno-vect-cost-model" } */
+
+#include <stdint-gcc.h>
+
+#define N 128
+
+static inline uint8_t
+clip_uint8 (int x)
+{
+  return x & ~255 ? (-x) >> 31 : x;
+}
+
+__attribute__ ((noipa)) static void
+clip_loop (uint8_t *__restrict dst, const int16_t *__restrict src, int n)
+{
+  for (int i = 0; i < n; ++i)
+    {
+      int x = (src[i] >> 8) * 256 + (src[i] & 255);
+      dst[i] = clip_uint8 (x);
+    }
+}
+
+int
+main (void)
+{
+  static const int16_t values[] = {
+    INT16_MIN, -1, 0, 255, 256, INT16_MAX
+  };
+  static const uint8_t expected[] = { 0, 0, 0, 255, 255, 255 };
+  int16_t input[N];
+  uint8_t output[N];
+
+  for (int i = 0; i < N; ++i)
+    input[i] = values[i % 6];
+
+  clip_loop (output, input, N);
+
+#pragma GCC novector
+  for (int i = 0; i < N; ++i)
+    if (output[i] != expected[i % 6])
+      __builtin_abort ();
+
+  return 0;
+}
