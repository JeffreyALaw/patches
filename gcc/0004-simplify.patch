diff --git a/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-1.c b/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-1.c
new file mode 100644
index 000000000000..986e277eac7d
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-1.c
@@ -0,0 +1,56 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv64gc_zbb -mabi=lp64d" } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" } } */
+
+/* RISC-V has no sge/sgeu, so the inverse of a comparison is computed as a
+   set-on-less-than followed by xori 1.  When that value is ANDed with
+   another comparison result, which is known to be 0 or 1, the xori is
+   equivalent to a NOT and the pair folds into a single andn.  */
+
+int
+f_lt (long a, long b, long c, long d)
+{
+  return (a < b) & !(c < d);
+}
+
+int
+f_gt (long a, long b, long c, long d)
+{
+  return (a < b) & !(c > d);
+}
+
+int
+f_ltu (unsigned long a, unsigned long b, unsigned long c, unsigned long d)
+{
+  return (a < b) & !(c < d);
+}
+
+int
+f_gtu (unsigned long a, unsigned long b, unsigned long c, unsigned long d)
+{
+  return (a < b) & !(c > d);
+}
+
+/* The inverted comparison as the first operand.  */
+int
+f_swapped (long a, long b, long c, long d)
+{
+  return !(c < d) & (a < b);
+}
+
+/* 32-bit operands.  */
+int
+f_si (int a, int b, int c, int d)
+{
+  return (a < b) & !(c < d);
+}
+
+/* The other operand is itself an AND of comparisons.  */
+int
+f_and (long a, long b, long c, long d, long e, long f)
+{
+  return ((a < b) & (e < f)) & !(c < d);
+}
+
+/* { dg-final { scan-assembler-times "\tandn\t" 7 } } */
+/* { dg-final { scan-assembler-not "\txori\t" } } */
diff --git a/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-2.c b/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-2.c
new file mode 100644
index 000000000000..95928487226e
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-2.c
@@ -0,0 +1,15 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv64gc_zbb -mabi=lp64d" } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" } } */
+
+/* The other operand is not known to be 0 or 1, so the xori cannot be
+   treated as a NOT: (x ^ 1) & b clears bit 0 of b when x is 1, whereas
+   ~x & b would keep the upper bits of b.  */
+
+long
+f (long a, long b, long c, long d)
+{
+  return (long) !(c < d) & a;
+}
+
+/* { dg-final { scan-assembler-not "\tandn\t" } } */
