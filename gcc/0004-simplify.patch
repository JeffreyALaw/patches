diff --git a/gcc/simplify-rtx.cc b/gcc/simplify-rtx.cc
index e979d4c29641..617b421f32a0 100644
--- a/gcc/simplify-rtx.cc
+++ b/gcc/simplify-rtx.cc
@@ -3168,6 +3168,43 @@ simplify_rotate_op (rtx op0, rtx op1, machine_mode mode)
   return NULL_RTX;
 }
 
+/* Try to combine two unsigned comparisons against the same value, OP0 and
+   OP1, joined by CODE (IOR or AND), into one comparison of a UMIN/UMAX:
+
+     (A <=u C) | (B <=u C)  ->  umin (A, B) <=u C
+     (A <=u C) & (B <=u C)  ->  umax (A, B) <=u C
+     (A >u C) | (B >u C)    ->  umax (A, B) >u C
+     (A >u C) & (B >u C)    ->  umin (A, B) >u C
+
+   and likewise for LTU and GEU.
+
+   Return the combined RTX or NULL_RTX otherwise.  */
+
+static rtx
+simplify_unsigned_cmp_minmax (rtx_code code, machine_mode mode,
+			      rtx op0, rtx op1)
+{
+  rtx_code cmp = GET_CODE (op0);
+  if (STORE_FLAG_VALUE != 1
+      || GET_CODE (op1) != cmp
+      || (cmp != LEU && cmp != LTU && cmp != GEU && cmp != GTU)
+      || !SCALAR_INT_MODE_P (mode)
+      || !rtx_equal_p (XEXP (op0, 1), XEXP (op1, 1))
+      || side_effects_p (op0)
+      || side_effects_p (op1))
+    return NULL_RTX;
+
+  machine_mode cmp_mode = GET_MODE (XEXP (op0, 0));
+  if (!SCALAR_INT_MODE_P (cmp_mode) || GET_MODE (XEXP (op1, 0)) != cmp_mode)
+    return NULL_RTX;
+
+  bool less = cmp == LEU || cmp == LTU;
+  rtx_code minmax = (less == (code == IOR)) ? UMIN : UMAX;
+  rtx m = simplify_gen_binary (minmax, cmp_mode,
+			       XEXP (op0, 0), XEXP (op1, 0));
+  return simplify_gen_relational (cmp, mode, cmp_mode, m, XEXP (op0, 1));
+}
+
 /* Returns true if OP0 and OP1 match the pattern (OP (plus (A - 1)) (neg A)),
    and the pattern can be simplified (there are no side effects).  */
 
@@ -3877,6 +3914,25 @@ simplify_context::simplify_binary_operation_1 (rtx_code code,
 	  && GET_MODE_CLASS (mode) != MODE_CC)
 	return CONSTM1_RTX (mode);
 
+      if (rtx tem = simplify_unsigned_cmp_minmax (IOR, mode, op0, op1))
+	return tem;
+
+      /* Convert (ior (xor A 1) (xor B 1)) to (xor (and A B) 1) when A and B
+	 are both known to be 0 or 1.  */
+      if (is_a <scalar_int_mode> (mode, &int_mode)
+	  && HWI_COMPUTABLE_MODE_P (int_mode)
+	  && GET_CODE (op0) == XOR
+	  && GET_CODE (op1) == XOR
+	  && XEXP (op0, 1) == CONST1_RTX (mode)
+	  && XEXP (op1, 1) == CONST1_RTX (mode)
+	  && (nonzero_bits (XEXP (op0, 0), int_mode) & ~HOST_WIDE_INT_1U) == 0
+	  && (nonzero_bits (XEXP (op1, 0), int_mode) & ~HOST_WIDE_INT_1U) == 0)
+	return simplify_gen_binary (XOR, mode,
+				    simplify_gen_binary (AND, mode,
+							 XEXP (op0, 0),
+							 XEXP (op1, 0)),
+				    CONST1_RTX (mode));
+
       /* IOR of two single bit bitfields extracted from the same object.
 	 Bitfields are represented as an AND based extraction */
       if (GET_CODE (op0) == AND
@@ -4484,6 +4540,44 @@ simplify_context::simplify_binary_operation_1 (rtx_code code,
 	  && GET_MODE_CLASS (mode) != MODE_CC)
 	return CONST0_RTX (mode);
 
+      if (rtx tem = simplify_unsigned_cmp_minmax (AND, mode, op0, op1))
+	return tem;
+
+      /* Convert (and (xor A 1) (xor B 1)) to (xor (ior A B) 1) when A and B
+	 are both known to be 0 or 1.  */
+      if (is_a <scalar_int_mode> (mode, &int_mode)
+	  && HWI_COMPUTABLE_MODE_P (int_mode)
+	  && GET_CODE (op0) == XOR
+	  && GET_CODE (op1) == XOR
+	  && XEXP (op0, 1) == CONST1_RTX (mode)
+	  && XEXP (op1, 1) == CONST1_RTX (mode)
+	  && (nonzero_bits (XEXP (op0, 0), int_mode) & ~HOST_WIDE_INT_1U) == 0
+	  && (nonzero_bits (XEXP (op1, 0), int_mode) & ~HOST_WIDE_INT_1U) == 0)
+	return simplify_gen_binary (XOR, mode,
+				    simplify_gen_binary (IOR, mode,
+							 XEXP (op0, 0),
+							 XEXP (op1, 0)),
+				    CONST1_RTX (mode));
+
+      /* Convert (and (xor A 1) B) to (and (not A) B) when B is known to be
+	 0 or 1.  Only bit 0 of the XOR matters, and the NOT may be folded
+	 into an and-not instruction.  */
+      if (is_a <scalar_int_mode> (mode, &int_mode)
+	  && HWI_COMPUTABLE_MODE_P (int_mode))
+	for (int i = 0; i < 2; i++)
+	  {
+	    rtx x = i ? op1 : op0;
+	    rtx y = i ? op0 : op1;
+	    if (GET_CODE (x) == XOR
+		&& XEXP (x, 1) == CONST1_RTX (mode)
+		&& (nonzero_bits (y, int_mode) & ~HOST_WIDE_INT_1U) == 0)
+	      return simplify_gen_binary (AND, mode,
+					  simplify_gen_unary (NOT, mode,
+							      XEXP (x, 0),
+							      mode),
+					  y);
+	  }
+
       /* Convert (and (plus (A - 1)) (neg A)) to 0.  */
       if (match_plus_neg_pattern (op0, op1, mode))
 	return CONST0_RTX (mode);
diff --git a/gcc/testsuite/gcc.target/riscv/xor1-demorgan-1.c b/gcc/testsuite/gcc.target/riscv/xor1-demorgan-1.c
new file mode 100644
index 000000000000..5fcec85dbd46
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/xor1-demorgan-1.c
@@ -0,0 +1,39 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv64gc_zbb -mabi=lp64d" } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" } } */
+
+/* RISC-V has no sge/sgeu, so the inverse of a comparison is computed as a
+   set-on-less-than followed by xori 1.  When two such inverted values, each
+   known to be 0 or 1, are ANDed, (!A & !B) is !(A | B).  With Zbb the pair
+   of compares is combined with seqz and andn.  */
+
+int
+f_lt (long a, long b, long c, long d)
+{
+  return !(a < b) & !(c < d);
+}
+
+int
+f_gt (long a, long b, long c, long d)
+{
+  return !(a < b) & !(c > d);
+}
+
+int
+f_ltu (unsigned long a, unsigned long b, unsigned long c, unsigned long d)
+{
+  return !(a < b) & !(c < d);
+}
+
+/* 32-bit operands.  */
+int
+f_si (int a, int b, int c, int d)
+{
+  return !(a < b) & !(c < d);
+}
+
+/* { dg-final { scan-assembler-times "\tseqz\t" 4 } } */
+/* { dg-final { scan-assembler-times "\tandn\t" 4 } } */
+/* { dg-final { scan-assembler-not "\tor\t" } } */
+/* { dg-final { scan-assembler-not "\tand\t" } } */
+/* { dg-final { scan-assembler-not "\txori\t" } } */
