	PR rtl-optimization/128767
gcc
	* simplify-rtx.cc (simplify_context::simplify_binary_operation_1):
	Simplify (and (xor A 1) B) to (and not (A) B) when B is a 0/1 value.

gcc/testsuite

	* gcc.target/riscv/abb-andn-xor1-1.c: New test.
	* gcc.target/riscv/abb-andn-xor1-2.c: New test.
	* gcc.target/riscv/abb-andn-xor1-3.c: New test.
	* gcc.target/riscv/abb-andn-xor1-4.c: New test.
	* gcc.target/aarch64/bic-1.c: Adjust expected output.

diff --git a/gcc/simplify-rtx.cc b/gcc/simplify-rtx.cc
index fb3a83bd3aef..3146bb5b0a2f 100644
--- a/gcc/simplify-rtx.cc
+++ b/gcc/simplify-rtx.cc
@@ -4485,6 +4541,25 @@ simplify_context::simplify_binary_operation_1 (rtx_code code,
 	  && GET_MODE_CLASS (mode) != MODE_CC)
 	return CONST0_RTX (mode);
 
+      /* Convert (and (xor A 1) B) to (and (not A) B) when B is known to be
+	 0 or 1.  Only bit 0 of the XOR matters, and the NOT may be folded
+	 into an and-not instruction.  */
+      if (is_a <scalar_int_mode> (mode, &int_mode)
+	  && HWI_COMPUTABLE_MODE_P (int_mode))
+	for (int i = 0; i < 2; i++)
+	  {
+	    rtx x = i ? op1 : op0;
+	    rtx y = i ? op0 : op1;
+	    if (GET_CODE (x) == XOR
+		&& XEXP (x, 1) == CONST1_RTX (mode)
+		&& (nonzero_bits (y, int_mode) & ~HOST_WIDE_INT_1U) == 0)
+	      return simplify_gen_binary (AND, mode,
+					  simplify_gen_unary (NOT, mode,
+							      XEXP (x, 0),
+							      mode),
+					  y);
+	  }
+
       /* Convert (and (plus (A - 1)) (neg A)) to 0.  */
       if (match_plus_neg_pattern (op0, op1, mode))
 	return CONST0_RTX (mode);
diff --git a/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-1.c b/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-1.c
new file mode 100644
index 000000000000..986e277eac7d
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-1.c
@@ -0,0 +1,56 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv64gc_zbb -mabi=lp64d" } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" } } */
+
+/* RISC-V has no sge/sgeu, so the inverse of a comparison is computed as a
+   set-on-less-than followed by xori 1.  When that value is ANDed with
+   another comparison result, which is known to be 0 or 1, the xori is
+   equivalent to a NOT and the pair folds into a single andn.  */
+
+int
+f_lt (long a, long b, long c, long d)
+{
+  return (a < b) & !(c < d);
+}
+
+int
+f_gt (long a, long b, long c, long d)
+{
+  return (a < b) & !(c > d);
+}
+
+int
+f_ltu (unsigned long a, unsigned long b, unsigned long c, unsigned long d)
+{
+  return (a < b) & !(c < d);
+}
+
+int
+f_gtu (unsigned long a, unsigned long b, unsigned long c, unsigned long d)
+{
+  return (a < b) & !(c > d);
+}
+
+/* The inverted comparison as the first operand.  */
+int
+f_swapped (long a, long b, long c, long d)
+{
+  return !(c < d) & (a < b);
+}
+
+/* 32-bit operands.  */
+int
+f_si (int a, int b, int c, int d)
+{
+  return (a < b) & !(c < d);
+}
+
+/* The other operand is itself an AND of comparisons.  */
+int
+f_and (long a, long b, long c, long d, long e, long f)
+{
+  return ((a < b) & (e < f)) & !(c < d);
+}
+
+/* { dg-final { scan-assembler-times "\tandn\t" 7 } } */
+/* { dg-final { scan-assembler-not "\txori\t" } } */
diff --git a/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-2.c b/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-2.c
new file mode 100644
index 000000000000..95928487226e
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-2.c
@@ -0,0 +1,15 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv64gc_zbb -mabi=lp64d" } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" } } */
+
+/* The other operand is not known to be 0 or 1, so the xori cannot be
+   treated as a NOT: (x ^ 1) & b clears bit 0 of b when x is 1, whereas
+   ~x & b would keep the upper bits of b.  */
+
+long
+f (long a, long b, long c, long d)
+{
+  return (long) !(c < d) & a;
+}
+
+/* { dg-final { scan-assembler-not "\tandn\t" } } */
diff --git a/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-3.c b/gcc/testsuite/gcc.target/riscv/zbb-andn-xor1-3.c
