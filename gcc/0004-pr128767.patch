+++ b/gcc/testsuite/gcc.target/riscv/zbb-minu-leu-2.c
@@ -0,0 +1,32 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv32gc_zbb -mabi=ilp32d" } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-Og" } } */
+
+/* RV32 version of zbb-minu-leu-1.c.  (A <=u C) | (B <=u C) is
+   umin (A, B) <=u C, which takes two instructions instead of the three
+   needed to compute each comparison and OR them.  */
+
+int
+f_or (unsigned a, unsigned b)
+{
+  return (a <= 12) | (b <= 12);
+}
+
+/* The operands in the other order.  */
+int
+f_swapped (unsigned a, unsigned b)
+{
+  return (b <= 12) | (a <= 12);
+}
+
+/* The constants differ, so there is no common bound to apply to the
+   minimum.  This must not use minu.  */
+int
+f_diff (unsigned a, unsigned b)
+{
+  return (a <= 12) | (b <= 13);
+}
+
+/* { dg-final { scan-assembler-times "\tminu\t" 2 } } */
+/* { dg-final { scan-assembler-times "\tsltiu\t" 4 } } */
+/* { dg-final { scan-assembler-times "\tor\t" 1 } } */
diff --git a/gcc/testsuite/gcc.target/riscv/zbb-minu-leu-3.c b/gcc/testsuite/gcc.target/riscv/zbb-minu-leu-3.c
new file mode 100644
index 00000000000..ba245a5e79d
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/zbb-minu-leu-3.c
@@ -0,0 +1,18 @@
+/* { dg-do compile } */
+/* { dg-options "-O3 -march=rv64gcbv_zicond_zvl128b -mabi=lp64" } */
+/* { dg-skip-if "" { *-*-* } { "-O0" "-O1" "-O2" "-Os" "-Og" } } */
+
+/* The vectorizer guards this loop with a runtime alias check, which tests
+   that neither address difference is within 12 bytes of zero.  That is
+   !(A <=u 12) && !(B <=u 12), which should be computed as
+   !(umin (A, B) <=u 12) and branched on directly.  */
+
+void
+f (short *a, short *b, short *c)
+{
+  for (int i = 0; i < 16; i++)
+    a[i] = b[i] + c[i];
+}
+
+/* { dg-final { scan-assembler-times "\tminu\t" 1 } } */
+/* { dg-final { scan-assembler-not "\tseqz\t" } } */
