diff --git a/gcc/reorg.cc b/gcc/reorg.cc
index 76b3e1438..2f8cd7223 100644
--- a/gcc/reorg.cc
+++ b/gcc/reorg.cc
@@ -670,7 +670,7 @@ note_delay_statistics (int slots_filled, int index)
 static void
 optimize_skip (rtx_jump_insn *insn, vec<rtx_insn *> *delay_list)
 {
-  rtx_insn *trial = next_nonnote_insn (insn);
+  rtx_insn *trial = next_nonnote_nondebug_insn (insn);
   rtx_insn *next_trial = next_active_insn (trial);
   int flags;
 
@@ -1765,7 +1765,7 @@ get_label_before (rtx_insn *insn, rtx sibling)
 
   /* Find an existing label at this point
      or make a new one if there is none.  */
-  label = prev_nonnote_insn (insn);
+  label = prev_nonnote_nondebug_insn (insn);
 
   if (label == 0 || !LABEL_P (label))
     {
@@ -2580,7 +2580,7 @@ fill_slots_from_thread (rtx_jump_insn *insn, rtx condition,
 	  && REG_P (SET_DEST (pat))
 	  && !reg_overlap_mentioned_p (SET_DEST (pat), SET_SRC (pat)))
 	{
-	  rtx_insn *next = next_nonnote_insn (trial);
+	  rtx_insn *next = next_nonnote_nondebug_insn (trial);
 
 	  if (next && NONJUMP_INSN_P (next)
 	      && GET_CODE (PATTERN (next)) != USE
diff --git a/gcc/testsuite/gcc.target/sparc/reorg-fill-slots-regcopy-debug.c b/gcc/testsuite/gcc.target/sparc/reorg-fill-slots-regcopy-debug.c
new file mode 100644
index 000000000..e23ae1ee1
--- /dev/null
+++ b/gcc/testsuite/gcc.target/sparc/reorg-fill-slots-regcopy-debug.c
@@ -0,0 +1,29 @@
+/* PR rtl-optimization/127725 */
+/* { dg-do compile } */
+/* { dg-options "-O2 -mcpu=v8 -fno-var-tracking -fcompare-debug --param=max-delay-slot-live-search=100000 --param=max-delay-slot-insn-search=100000" } */
+
+int h (int);
+
+int
+f (void)
+{
+  unsigned int mid;
+  unsigned int lo = 0;
+  unsigned int hi = 3;
+  unsigned int last = -1;
+
+  for (;;)
+    {
+      mid = (lo + hi) / 2;
+      if (last == mid)
+	return 0;
+      last = mid;
+      int r = h (mid);
+      if (r < 0)
+	hi = mid;
+      else if (r > 0)
+	lo = mid;
+      else
+	return 1;
+    }
+}
