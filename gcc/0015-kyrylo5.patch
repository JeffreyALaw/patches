diff --git a/gcc/testsuite/gcc.dg/torture/switch-dispatch-run-8.c b/gcc/testsuite/gcc.dg/torture/switch-dispatch-run-8.c
new file mode 100644
index 00000000000..d3391e53587
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/torture/switch-dispatch-run-8.c
@@ -0,0 +1,47 @@
+/* PR middle-end/126236 */
+/* { dg-do run } */
+/* { dg-additional-options "-fduplicate-switch-dispatch --param=max-goto-duplication-insns=128 --param=case-values-threshold=1" } */
+
+/* The block with the asm goto falls through to the range check of the
+   switch, and the asm goto names that block as well.  Such a block must
+   not become part of a copy of the dispatch.  */
+
+volatile unsigned int sd_count[12];
+
+__attribute__ ((noipa)) void
+sd_interp (const unsigned char *pc)
+{
+  sd_count[0] = 0;
+  for (;;)
+    {
+      unsigned int op = *pc++;
+      asm goto ("" :::: next);
+    next:
+      switch (op)
+	{
+	case 0: return;
+	case 1: sd_count[1] += 1; break;
+	case 2: sd_count[2] += 2; break;
+	case 3: sd_count[3] += 3; break;
+	case 4: sd_count[4] += 4; break;
+	case 5: sd_count[5] += 5; break;
+	case 6: sd_count[6] += 6; break;
+	case 7: sd_count[7] += 7; break;
+	case 8: sd_count[8] += 8; break;
+	case 9: sd_count[9] += 9; break;
+	case 10: sd_count[10] += 10; break;
+	default: sd_count[11] += 11; break;
+	}
+    }
+}
+
+int
+main (void)
+{
+  static const unsigned char prog[] = { 1, 2, 3, 200, 10, 0 };
+  sd_interp (prog);
+  if (sd_count[1] != 1 || sd_count[2] != 2 || sd_count[3] != 3
+      || sd_count[10] != 10 || sd_count[11] != 11)
+    __builtin_abort ();
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.target/aarch64/switch-dispatch-1.c b/gcc/testsuite/gcc.target/aarch64/switch-dispatch-1.c
new file mode 100644
index 00000000000..5d60bed79d9
--- /dev/null
+++ b/gcc/testsuite/gcc.target/aarch64/switch-dispatch-1.c
@@ -0,0 +1,39 @@
+/* PR middle-end/126236 */
+/* { dg-do assemble } */
+/* { dg-options "-O2 -fduplicate-switch-dispatch -save-temps" } */
+
+/* Each of the 11 continuing handlers, the default handler and the loop entry
+   get a dispatch of their own, so 13 register indirect branches.  All of them
+   share the one table, whose entries are relative to a single base label,
+   which must be defined exactly once.  */
+
+void
+interp (const unsigned char *pc, volatile unsigned *state)
+{
+  for (;;)
+    switch (*pc++)
+      {
+      case 0: return;
+      case 1: state[0] += 1; break;
+      case 2: state[1] ^= 2; break;
+      case 3: state[2] -= 3; break;
+      case 4: state[3] |= 4; break;
+      case 5: state[4] &= 5; break;
+      case 6: state[5] += 6; break;
+      case 7: state[6] ^= 7; break;
+      case 8: state[7] -= 8; break;
+      case 9: state[8] |= 9; break;
+      case 10: state[9] &= 10; break;
+      case 11: state[10] += 11; break;
+      default: state[11] ^= 12; break;
+      }
+}
+
+/* { dg-final { scan-assembler-times "\\tbr\\tx" 13 } } */
+/* { dg-final { scan-assembler-times "\\.Lrtx\[0-9\]+:" 1 } } */
+
+/* A copy can sit far from that one base label, further than ADR reaches, so the
+   copies materialise it with ADRP and ADD.  */
+/* { dg-final { scan-assembler-times "adrp\\tx\[0-9\]+, \\.Lrtx" 13 } } */
+/* { dg-final { scan-assembler-times "add\\tx\[0-9\]+, x\[0-9\]+, :lo12:\\.Lrtx" 13 } } */
+/* { dg-final { scan-assembler-not "\\tadr\\tx\[0-9\]+, \\.Lrtx" } } */
diff --git a/gcc/testsuite/gcc.target/aarch64/switch-dispatch-2.c b/gcc/testsuite/gcc.target/aarch64/switch-dispatch-2.c
new file mode 100644
index 00000000000..9824a805683
--- /dev/null
+++ b/gcc/testsuite/gcc.target/aarch64/switch-dispatch-2.c
@@ -0,0 +1,32 @@
+/* PR middle-end/126236 */
+/* { dg-do compile } */
+/* { dg-options "-O2 -fduplicate-switch-dispatch -mbranch-protection=bti" } */
+
+/* Duplicating the dispatch must not duplicate the landing pads: one BTI J per
+   case handler, not one per handler per dispatch copy.  */
+
+void
+interp (const unsigned char *pc, volatile unsigned *state)
+{
+  for (;;)
+    switch (*pc++)
+      {
+      case 0: return;
+      case 1: state[0] += 1; break;
+      case 2: state[1] ^= 2; break;
+      case 3: state[2] -= 3; break;
+      case 4: state[3] |= 4; break;
+      case 5: state[4] &= 5; break;
+      case 6: state[5] += 6; break;
+      case 7: state[6] ^= 7; break;
+      case 8: state[7] -= 8; break;
+      case 9: state[8] |= 9; break;
+      case 10: state[9] &= 10; break;
+      case 11: state[10] += 11; break;
+      default: state[11] ^= 12; break;
+      }
+}
+
+/* 12 table targets plus the function entry.  */
+/* { dg-final { scan-assembler-times "bti\\tj|hint\\t36" 12 } } */
+/* { dg-final { scan-assembler-times "bti\\tc|hint\\t34" 1 } } */
diff --git a/gcc/testsuite/gcc.target/aarch64/switch-dispatch-3.c b/gcc/testsuite/gcc.target/aarch64/switch-dispatch-3.c
new file mode 100644
index 00000000000..46455328128
--- /dev/null
+++ b/gcc/testsuite/gcc.target/aarch64/switch-dispatch-3.c
@@ -0,0 +1,30 @@
+/* PR middle-end/126236 */
+/* { dg-do compile } */
+/* { dg-options "-O2 -fduplicate-switch-dispatch -fdump-rtl-compgotos-details" } */
+
+/* The dispatch of an interpreter loop is duplicated into the handlers that
+   branch back to it.  There are 11 such handlers plus the default one.  */
+
+void
+interp (const unsigned char *pc, volatile unsigned *state)
+{
+  for (;;)
+    switch (*pc++)
+      {
+      case 0: return;
+      case 1: state[0] += 1; break;
+      case 2: state[1] ^= 2; break;
+      case 3: state[2] -= 3; break;
+      case 4: state[3] |= 4; break;
+      case 5: state[4] &= 5; break;
+      case 6: state[5] += 6; break;
+      case 7: state[6] ^= 7; break;
+      case 8: state[7] -= 8; break;
+      case 9: state[8] |= 9; break;
+      case 10: state[9] &= 10; break;
+      case 11: state[10] += 11; break;
+      default: state[11] ^= 12; break;
+      }
+}
