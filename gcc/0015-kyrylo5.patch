diff --git a/gcc/testsuite/gcc.dg/plugin/tablejump-capability.c b/gcc/testsuite/gcc.dg/plugin/tablejump-capability.c
new file mode 100644
index 00000000000..93d50fcfa09
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/plugin/tablejump-capability.c
@@ -0,0 +1,25 @@
+/* PR middle-end/126236 */
+/* { dg-do assemble { target aarch64*-*-* } } */
+/* { dg-options "-O2 -fchecking -fduplicate-switch-dispatch" } */
+
+void allowed (const unsigned char *, volatile unsigned *)
+  __attribute__ ((noipa, target ("arch=armv8-a+crc")));
+void rejected (const unsigned char *, volatile unsigned *)
+  __attribute__ ((noipa, target ("arch=armv8-a+nocrc")));
+void vetoed (const unsigned char *, volatile unsigned *)
+  __attribute__ ((noipa, target ("arch=armv8-a+crc")));
+
+#define TEST_NAME allowed
+#include "tablejump-test.h"
+#undef TEST_NAME
+#define TEST_NAME rejected
+#include "tablejump-test.h"
+#undef TEST_NAME
+#define TEST_NAME vetoed
+#include "tablejump-test.h"
+
+int
+ordinary (int x)
+{
+  return x + 1;
+}
diff --git a/gcc/testsuite/gcc.dg/plugin/tablejump-test.h b/gcc/testsuite/gcc.dg/plugin/tablejump-test.h
new file mode 100644
index 00000000000..3e90c1efd63
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/plugin/tablejump-test.h
@@ -0,0 +1,24 @@
+/* PR middle-end/126236 */
+/* A loop with shared dispatches and repeated table entries.  */
+
+void
+TEST_NAME (const unsigned char *pc, volatile unsigned *state)
+{
+  for (;;)
+    switch (*pc++)
+      {
+      case 0: return;
+      case 1: case 12: state[0] += 1; break;
+      case 2: state[1] ^= 2; break;
+      case 3: state[2] -= 3; break;
+      case 4: state[3] |= 4; break;
+      case 5: state[4] &= 5; break;
+      case 6: state[5] += 6; break;
+      case 7: state[6] ^= 7; break;
+      case 8: state[7] -= 8; break;
+      case 9: state[8] |= 9; break;
+      case 10: state[9] &= 10; break;
+      case 11: state[10] += 11; break;
+      default: state[11] ^= 12; break;
+      }
+}
diff --git a/gcc/testsuite/gcc.dg/plugin/tablejump_capability_plugin.cc b/gcc/testsuite/gcc.dg/plugin/tablejump_capability_plugin.cc
new file mode 100644
index 00000000000..c6c16e5d448
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/plugin/tablejump_capability_plugin.cc
@@ -0,0 +1,182 @@
+/* PR middle-end/126236 */
+/* { dg-options "-O0" } */
+
+#include "gcc-plugin.h"
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tm.h"
+#include "rtl.h"
+#include "tree.h"
+#include "function.h"
+#include "memmodel.h"
+#include "emit-rtl.h"
+#include "tree-pass.h"
+#include "target.h"
+#include "context.h"
+#include "plugin-version.h"
+
+int plugin_is_GPL_compatible;
+
+static bool (*saved_can_share) (rtx_insn *);
+static bool (*saved_cannot_copy) (rtx_insn *);
+static void (*saved_base) (FILE *, rtx_jump_table_data *, unsigned long);
+static unsigned queries, late_queries, veto_queries;
+static unsigned functions, expected_bases, emitted_bases;
+static bool veto;
+
+/* Return whether the current function enables CRC instructions.  */
+
+static bool
+crc_enabled_p ()
+{
+#ifdef AARCH64_HAVE_ISA
+  return TARGET_CRC32;
+#else
+  gcc_unreachable ();
+#endif
+}
+
+/* Check the real tablejump INSN and allow sharing according to the current
+   function's target options.  The target's own answer does not depend on
+   whether it emits a table base.  */
+
+static bool
+can_share (rtx_insn *insn)
+{
+  gcc_assert (tablejump_p (insn, NULL, NULL));
+  auto base = targetm.asm_out.jump_table_base;
+  targetm.asm_out.jump_table_base = NULL;
+  gcc_assert (saved_can_share (insn));
+  targetm.asm_out.jump_table_base = base;
+  gcc_assert (saved_can_share (insn));
+  ++queries;
+  return crc_enabled_p ();
+}
+
+/* Reject sharing and record any query outside the duplication pass.  */
+
+static bool
+reject_late (rtx_insn *)
+{
+  ++late_queries;
+  return false;
+}
+
+/* Reject copying a tablejump INSN in the selected function.  */
+
+static bool
+cannot_copy (rtx_insn *insn)
+{
+  if (veto && tablejump_p (insn, NULL, NULL))
+    {
+      ++veto_queries;
+      return true;
+    }
+  return saved_cannot_copy && saved_cannot_copy (insn);
+}
+
+/* Emit TABLE's base with LABELNO to STREAM while eligibility is false.  */
+
+static void
+emit_base (FILE *stream, rtx_jump_table_data *table, unsigned long labelno)
+{
+  gcc_assert (targetm.can_share_jump_table_p == reject_late);
+  gcc_assert (JUMP_TABLE_SHARED_P (PATTERN (table)));
+  ++emitted_bases;
+  if (saved_base)
+    saved_base (stream, table, labelno);
+}
+
+const pass_data capability_pass_data =
+{
+  RTL_PASS, "tablejump_capability", OPTGROUP_NONE, TV_NONE,
+  PROP_rtl, 0, 0, 0, 0
+};
+
+class capability_pass : public rtl_opt_pass
+{
+public:
+  capability_pass (gcc::context *ctxt, bool before)
+    : rtl_opt_pass (capability_pass_data, ctxt), m_before (before)
+  {}
+
+  unsigned int execute (function *fun) final override
+  {
+    const char *name = IDENTIFIER_POINTER (DECL_NAME (fun->decl));
+    bool ordinary = !strcmp (name, "ordinary");
+    bool allowed = !strcmp (name, "allowed");
+    unsigned tables = 0, shared = 0, jumps = 0;
+    for (rtx_insn *insn = get_insns (); insn; insn = NEXT_INSN (insn))
+      {
+	if (JUMP_TABLE_DATA_P (insn))
+	  {
+	    ++tables;
+	    shared += JUMP_TABLE_SHARED_P (PATTERN (insn));
+	  }
+	jumps += tablejump_p (insn, NULL, NULL);
+      }
+    gcc_assert (tables == (ordinary ? 0 : 1));
+    gcc_assert (!late_queries);
+    if (!ordinary)
+      gcc_assert (crc_enabled_p () == !!strcmp (name, "rejected"));
+
+    if (m_before)
+      {
+	gcc_assert (!shared && jumps == tables);
+	queries = veto_queries = 0;
+	veto = !strcmp (name, "vetoed");
+	targetm.can_share_jump_table_p = can_share;
+	targetm.cannot_copy_insn_p = cannot_copy;
+      }
+    else
+      {
+	gcc_assert ((queries != 0) == !ordinary);
+	gcc_assert (shared == (allowed ? 1 : 0));
+	gcc_assert (allowed ? jumps > tables : jumps == tables);
+	gcc_assert ((veto_queries != 0) == veto);
+	expected_bases += shared;
+	++functions;
+	targetm.can_share_jump_table_p = reject_late;
+	targetm.cannot_copy_insn_p = saved_cannot_copy;
+      }
+    return 0;
+  }
+
+private:
+  bool m_before;
+};
+
+/* Check that all driver functions were tested and all shared bases emitted.  */
+
+static void
+finish_unit (void *, void *)
+{
+  gcc_assert (functions == 4);
+  gcc_assert (expected_bases == 1 && emitted_bases == expected_bases);
+  gcc_assert (!late_queries);
+}
+
+int
+plugin_init (struct plugin_name_args *info, struct plugin_gcc_version *version)
+{
+  if (!plugin_default_version_check (version, &gcc_version))
+    return 1;
+  saved_can_share = targetm.can_share_jump_table_p;
+  saved_cannot_copy = targetm.cannot_copy_insn_p;
+  saved_base = targetm.asm_out.jump_table_base;
+  targetm.can_share_jump_table_p = reject_late;
+  targetm.asm_out.jump_table_base = emit_base;
+  for (unsigned i = 0; i != 2; ++i)
+    {
+      struct register_pass_info pass;
+      pass.pass = new capability_pass (g, i == 0);
+      pass.reference_pass_name = "compgotos";
+      pass.ref_pass_instance_number = 1;
+      pass.pos_op = i == 0 ? PASS_POS_INSERT_BEFORE : PASS_POS_INSERT_AFTER;
+      register_callback (info->base_name, PLUGIN_PASS_MANAGER_SETUP, NULL,
+			 &pass);
+    }
+  register_callback (info->base_name, PLUGIN_FINISH_UNIT, finish_unit, NULL);
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.dg/switch-dispatch-2.c b/gcc/testsuite/gcc.dg/switch-dispatch-2.c
new file mode 100644
index 00000000000..ffd619defbe
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/switch-dispatch-2.c
@@ -0,0 +1,34 @@
+/* PR middle-end/126236 */
+/* { dg-do compile } */
+/* { dg-require-effective-target indirect_jumps } */
+/* { dg-options "-O2 -fduplicate-switch-dispatch --param=case-values-threshold=1 --param=max-goto-duplication-insns=128 -fdump-rtl-compgotos-details" } */
+
+/* The two paths converge on an attachable switch dispatch, but there is no
+   back edge into it.  */
+
+int
+plain (int x, int path, volatile int *state)
+{
+  if (path)
+    state[12] += path;
+  else
+    state[13] ^= x;
+
+  switch (x)
+    {
+    case 0: state[0] += 1; break;
+    case 1: state[1] ^= 2; break;
+    case 2: state[2] -= 3; break;
+    case 3: state[3] |= 4; break;
+    case 4: state[4] &= 5; break;
+    case 5: state[5] += 6; break;
+    case 6: state[6] ^= 7; break;
+    case 7: state[7] -= 8; break;
+    case 8: state[8] |= 9; break;
+    case 9: state[9] &= 10; break;
+    default: state[10] ^= 11; break;
+    }
+  return state[11];
+}
+
+/* { dg-final { scan-rtl-dump-not "Duplicating dispatch" "compgotos" } } */
