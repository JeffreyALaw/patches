+	  back_edges_marked = true;
+	}
+
+      changed |= maybe_duplicate_dispatch (bb, max_size, tablejump);
+    }
+
+  fun->curr_properties &= ~PROP_rtl_allow_tablejump_duplication;
 
   /* Some blocks may have become unreachable.  */
   if (changed)
