    Revert "[PATCH] match.pd: Fold (X | A) cmp C and (X ^ A) cmp C into X cmp C [PR115392]"
    
    This reverts commit 610ffda1010fd9c02ea73382a151c463a44e1d4b.

diff --git a/gcc/match.pd b/gcc/match.pd
index 07fb23ef84a5..91dde5d51fae 100644
--- a/gcc/match.pd
+++ b/gcc/match.pd
@@ -6005,47 +6005,6 @@ DEFINE_INT_AND_FLOAT_ROUND_FN (RINT)
    (with { wide_int c = wi::to_wide (@2) | wi::bit_not (wi::to_wide (@1)); }
     (cmp @0 { wide_int_to_tree (TREE_TYPE (@0), c); })))))
 
-/* Fold (X op A) cmp C, with op in { |, ^ } and cmp in {le,gt,lt,ge},
-   into X cmp C when all potentially nonzero bits of A are below bit m
-   and 0 < m < the precision of A (to avoid sign bit).
-   'A' leaves the bits of X at and above position m unchanged,
-   so the comparison is decided by the high parts alone when the
-   low m bits of C are all ones (cmp = le/gt) or all zeros (cmp = lt/ge).
-   Skip cases where A is known to be zero, which are handled by
-   other simplifications.  */
-(for cmp (le gt lt ge)
- (for bitop (bit_ior bit_xor)
-  (simplify
-   (cmp (bitop:c@3 @0 @1) INTEGER_CST@2)
-   (if (INTEGRAL_TYPE_P (TREE_TYPE (@2)))
-    (with
-     {
-       wide_int nz;
-       bool nz_valid = true;
-#if GIMPLE
-       int_range_max vr;
-       nz_valid = (gimple_match_range_of_expr (vr, @1, @3)
-		    && !vr.undefined_p ());
-       if (nz_valid)
-	  nz = vr.get_nonzero_bits ();
-#else
-	nz = tree_nonzero_bits (@1);
-#endif
-     }
-     (if (nz_valid)
-      (with
-       {
-	  unsigned int prec = TYPE_PRECISION (TREE_TYPE (@1));
-	  unsigned int m = prec - (unsigned int) wi::clz (nz);
-	  wide_int mask = wi::mask (m, false, prec);
-	  wide_int lowc = cmp == LE_EXPR || cmp == GT_EXPR
-			  ? mask : wi::zero (prec);
-       }
-       (if (0 < m && m < prec
-	    && wi::eq_p (wi::bit_and (wi::to_wide (@2), mask), lowc))
-	  (cmp @0 @2)))))))))
-
-
 /* Fold ((X << C1) & C2) cmp C3 into (X & (C2 >> C1)) cmp (C3 >> C1)
 	((X >> C1) & C2) cmp C3 into (X & (C2 << C1)) cmp (C3 << C1).  */
 (for cmp (ne eq)
diff --git a/gcc/testsuite/gcc.dg/ipa/pr91088.c b/gcc/testsuite/gcc.dg/ipa/pr91088.c
