diff --git a/gcc/ext-dce.cc b/gcc/ext-dce.cc
index e431bb0e404e..c700b537d2bf 100644
--- a/gcc/ext-dce.cc
+++ b/gcc/ext-dce.cc
@@ -554,10 +554,7 @@ ext_dce_try_optimize_extension (rtx_insn *insn, rtx set)
 
       gcc_assert (REG_P (x));
       if (ok)
-	{
-	  bitmap_set_bit (changed_pseudos, REGNO (x));
-	  remove_reg_equal_equiv_notes (insn, false);
-	}
+	bitmap_set_bit (changed_pseudos, REGNO (x));
 
       if (dump_file)
 	{
@@ -632,12 +629,6 @@ ext_dce_try_optimize_extension (rtx_insn *insn, rtx set)
 	  print_rtl_single (dump_file, new_pattern);
 	  fprintf (dump_file, "\n");
 	}
-
-      /* INSN may have a REG_EQUAL note indicating that the value was
-	 sign or zero extended.  That note is no longer valid since we've
-	 just removed the extension.  Just wipe the notes.  */
-      if (ok)
-	remove_reg_equal_equiv_notes (insn, false);
     }
   else
     {
@@ -772,9 +763,6 @@ ext_dce_try_promote_operation (rtx_insn *insn, rtx set)
       print_rtl_single (dump_file, new_src);
       fprintf (dump_file, "\n");
     }
-
-  if (ok)
-    remove_reg_equal_equiv_notes (insn, false);
 }
 
 /* Record INSN as a promotion candidate if it passes the same validity
@@ -1666,12 +1654,15 @@ expand_changed_pseudos (void)
    them with SUBREGs indicating certain bits are don't cares.
 
    This changes the SUBREG_PROMOTED_VAR_P state of the object.
-   It is fairly painful to fix this on the fly, so we have
-   recorded which pseudos are affected and we look for SUBREGs
-   of those pseudos and fix them up.  */
+   It also invalidates any REG_EQUAL/REG_EQUIV notes that describe
+   the object as extended.
+
+   It is fairly painful to fix this on the fly, so we have recorded
+   which pseudos are affected and we look for SUBREGs and notes
+   involving those pseudos and fix them up.  */
 
 static void
-reset_subreg_promoted_p (void)
+reset_promotion_and_equivalences (void)
 {
   /* This pass eliminates zero/sign extensions on pseudo regs found
      in CHANGED_PSEUDOS.  Elimination of those extensions changes if
@@ -1696,6 +1687,17 @@ reset_subreg_promoted_p (void)
 	continue;
 
       rtx pat = PATTERN (insn);
+
+      /* A REG_EQUAL/REG_EQUIV note on an insn that sets one of the
+	 affected pseudos (or a copy of one) may claim the value is
+	 sign/zero extended.  That is no longer true now that we've
+	 removed an extension, so remove REG_EQUAL and/or REG_EQUIV
+	 notes on those insns.   */
+      rtx set = single_set (insn);
+      if (set && REG_P (SET_DEST (set))
+	  && bitmap_bit_p (changed_pseudos, REGNO (SET_DEST (set))))
+	remove_reg_equal_equiv_notes (insn, false);
+
       subrtx_var_iterator::array_type array;
       FOR_EACH_SUBRTX_VAR (iter, array, pat, NONCONST)
 	{
@@ -1841,7 +1843,7 @@ ext_dce_execute (void)
     }
   while (modify);
 
-  reset_subreg_promoted_p ();
+  reset_promotion_and_equivalences ();
 
   ext_dce_finish ();
 }
