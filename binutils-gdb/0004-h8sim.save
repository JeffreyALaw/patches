 struct h8300_sim_state {
   unsigned long memory_size;
+  unsigned int sim_cache_size;
+  decoded_inst *sim_cache;
+  unsigned short *cache_idx;
+  int cache_top;
+  int compiles;
 #ifdef ADEBUG
   int stats[O_LAST];
 #endif

