 sim/h8300/compile.c   | 171 ++++++++++++++++++++++++++++++++++++++++++++++++--
 sim/h8300/h8300-sim.h |   5 ++
 2 files changed, 172 insertions(+), 4 deletions(-)

diff --git a/sim/h8300/compile.c b/sim/h8300/compile.c
index 06988095228..0c3d12f3ca4 100644
--- a/sim/h8300/compile.c
+++ b/sim/h8300/compile.c
@@ -51,6 +51,12 @@ static int nib_indices[16];
 
 static int memory_size;
 
+/* FIXME: Needs to live in header file.
+   This header should also include the things in remote-sim.h.
+   One could move this to remote-sim.h but this function isn't needed
+   by gdb.  */
+static void set_simcache_size (SIM_DESC, int);
+
 #define X(op, size)  (op * 4 + size)
 
 #define SP (h8300hmode && !h8300_normal_mode ? SL : SW)
@@ -92,6 +98,18 @@ h8_set_reg (sim_cpu *cpu, int regnum, int val)
 #define h8_get_macl(cpu)	h8_get_reg (cpu, MACL_REGNUM)
 #define h8_set_macl(cpu, val)	h8_set_reg (cpu, MACL_REGNUM, val)
 
+static int
+h8_get_cache_top (SIM_DESC sd)
+{
+  return H8300_SIM_STATE (sd)->cache_top;
+}
+
+static void
+h8_set_cache_top (SIM_DESC sd, int val)
+{
+  H8300_SIM_STATE (sd)->cache_top = val;
+}
+
 static int
 h8_get_mask (sim_cpu *cpu)
 {
@@ -129,6 +147,18 @@ h8_set_state (SIM_DESC sd, enum h8300_sim_state val)
 }
 #endif
 
+static int
+h8_get_compiles (SIM_DESC sd)
+{
+  return H8300_SIM_STATE (sd)->compiles;
+}
+
+static void
+h8_increment_compiles (SIM_DESC sd)
+{
+  H8300_SIM_STATE (sd)->compiles++;
+}
+
 static unsigned int *
 h8_get_reg_buf (sim_cpu *cpu)
 {
@@ -149,6 +179,32 @@ h8_increment_stats (SIM_DESC sd, int idx)
 }
 #endif /* ADEBUG */
 
+static unsigned short *
+h8_get_cache_idx_buf (SIM_DESC sd)
+{
+  return H8300_SIM_STATE (sd)->cache_idx;
+}
+
+static void
+h8_set_cache_idx_buf (SIM_DESC sd, unsigned short *ptr)
+{
+  H8300_SIM_STATE (sd)->cache_idx = ptr;
+}
+
+static unsigned short
+h8_get_cache_idx (SIM_DESC sd, unsigned int idx)
+{
+  if (idx > H8300_SIM_STATE (sd)->memory_size)
+    return (unsigned short) -1;
+  return H8300_SIM_STATE (sd)->cache_idx[idx];
+}
+
+static void
+h8_set_cache_idx (SIM_DESC sd, int idx, unsigned int val)
+{
+  H8300_SIM_STATE (sd)->cache_idx[idx] = (unsigned short) val;
+}
+
 static unsigned char *
 h8_get_memory_buf (sim_cpu *cpu)
 {
@@ -1062,6 +1118,35 @@ decode (SIM_DESC sd, sim_cpu *cpu, int addr, unsigned char *data, decoded_inst *
   dst->opcode = O (O_ILL, SB);
 }
 
+static void
+compile (SIM_DESC sd, int pc)
+{
+  int idx;
+
+  /* Find the next cache entry to use.  */
+  idx = h8_get_cache_top (sd) + 1;
+  h8_increment_compiles (sd);
+  if (idx >= H8300_SIM_STATE (sd)->sim_cache_size)
+    {
+      idx = 1;
+    }
+  h8_set_cache_top (sd, idx);
+
+  /* Throw away its old meaning.  */
+  h8_set_cache_idx (sd, H8300_SIM_STATE (sd)->sim_cache[idx].oldpc, 0);
+
+  /* Set to new address.  */
+  H8300_SIM_STATE (sd)->sim_cache[idx].oldpc = pc;
+
+  /* Fill in instruction info.  */
+  decode (sd, STATE_CPU(sd, 0), pc, h8_get_memory_buf (STATE_CPU(sd, 0)) + pc,
+		  H8300_SIM_STATE (sd)->sim_cache + idx);
+
+  /* Point to new cache entry.  */
+  h8_set_cache_idx (sd, pc, idx);
+}
+
+
 static unsigned char  *breg[32];
 static unsigned short *wreg[16];
 
@@ -1568,6 +1653,41 @@ store2 (SIM_DESC sd, ea_type *arg, int n)
   return store_1 (sd, arg, n, 1);
 }
 
+#ifdef __MINGW32__
+/* On Windows/MinGW, qsort for some reason produces a "shuffled" opcode
+table instead of a sorted one, causing the entire simulator to hang.
+
+This is a simple insertion sort implementation, but it has virtually
+no impact on simulator performance.  */
+
+#define qsort opcode_insertion_sort
+
+static void
+opcode_insertion_sort(void *base, size_t nmemb, size_t size,
+                      int (*compar)(const void *, const void *))
+{
+  unsigned char *a = base;
+  struct h8_opcode tmp;
+  size_t i, j;
+
+  if (nmemb < 2 || size == 0)
+    return;
+
+  for (i = 1; i < nmemb; ++i) {
+    memcpy(&tmp, a + i * size, size);
+
+    j = i;
+    while (j > 0 && compar(&tmp, a + (j - 1) * size) < 0) {
+      memcpy(a + j * size, a + (j - 1) * size, size);
+      --j;
+    }
+
+    memcpy(a + j * size, &tmp, size);
+  }
+
+}
+#endif /* #ifdef __MINGW32__ */
+
 /* Callback for qsort.  We sort first based on availability
    (available instructions sort lower).  When availability state
    is the same, then we use the first 4 bit nibble as a secondary
@@ -1677,9 +1797,13 @@ init_pointers (SIM_DESC sd)
 
       if (h8_get_memory_buf (cpu))
 	free (h8_get_memory_buf (cpu));
+      if (h8_get_cache_idx_buf (sd))
+	free (h8_get_cache_idx_buf (sd));
 
       h8_set_memory_buf (cpu, (unsigned char *)
 			 calloc (sizeof (char), memory_size));
+      h8_set_cache_idx_buf (sd, (unsigned short *) 
+			    calloc (sizeof (short), memory_size));
       state->memory_size = memory_size;
 
       h8_set_mask (cpu, memory_size - 1);
@@ -1732,6 +1856,10 @@ init_pointers (SIM_DESC sd)
       sort_opcodes_and_setup_nibble_indices (ops);
 
       init_pointers_needed = 0;
+
+      /* Initialize the seg registers.  */
+      if (!H8300_SIM_STATE(sd)->sim_cache)
+	set_simcache_size (sd, CSIZE);
     }
 }
 
@@ -1796,10 +1924,16 @@ step_once (SIM_DESC sd, SIM_CPU *cpu)
     h8_set_mask (cpu, 0xffff);
   do
     {
-      decoded_inst _code, *code = &_code;
-      memset (code, 0, sizeof (*code));
-      decode (sd, cpu, pc, h8_get_memory_buf (cpu) + pc, code);
-      code->oldpc = pc;
+      unsigned short cidx;
+      decoded_inst *code;
+
+    top:
+      cidx = h8_get_cache_idx (sd, pc);
+      if (cidx == (unsigned short) -1 ||
+	  cidx >= H8300_SIM_STATE(sd)->sim_cache_size)
+	goto illegal;
+	  
+      code = H8300_SIM_STATE(sd)->sim_cache + cidx;
 
 #if ADEBUG
       if (debug)
@@ -1818,6 +1952,15 @@ step_once (SIM_DESC sd, SIM_CPU *cpu)
 
       switch (code->opcode)
 	{
+	case 0:
+	  /*
+	   * This opcode is a fake for when we get to an
+	   * instruction which hasnt been compiled
+	   */
+	  compile (sd, pc);
+	  goto top;
+	  break;
+
 	case O (O_MOVAB, SL):
 	case O (O_MOVAW, SL):
 	case O (O_MOVAL, SL):
@@ -4438,6 +4581,7 @@ sim_write (SIM_DESC sd, uint64_t addr, const void *buffer, uint64_t size)
       if (addr < memory_size)
 	{
 	  h8_set_memory (cpu, addr + i, data[i]);
+	  h8_set_cache_idx (sd, addr + i,  0);
 	}
       else
 	break;
@@ -4569,6 +4713,19 @@ h8300_reg_fetch (SIM_CPU *cpu, int rn, void *buf, int length)
     }
 }
 
+static void
+set_simcache_size (SIM_DESC sd, int n)
+{
+  if (H8300_SIM_STATE(sd)->sim_cache)
+    free (H8300_SIM_STATE(sd)->sim_cache);
+  if (n < 2)
+    n = 2;
+  H8300_SIM_STATE(sd)->sim_cache = (decoded_inst *) malloc (sizeof (decoded_inst) * n);
+  memset (H8300_SIM_STATE(sd)->sim_cache, 0, sizeof (decoded_inst) * n);
+  H8300_SIM_STATE(sd)->sim_cache_size = n;
+}
+
+
 void
 sim_info (SIM_DESC sd, bool verbose)
 {
@@ -4582,6 +4739,8 @@ sim_info (SIM_DESC sd, bool verbose)
   sim_io_printf (sd, "#virtual time taken     %10.4f\n", virttime);
   if (timetaken != 0.0)
     sim_io_printf (sd, "#simulation ratio       %10.4f\n", virttime / timetaken);
+  sim_io_printf (sd, "#compiles               %10d\n", h8_get_compiles (sd));
+  sim_io_printf (sd, "#cache size             %10d\n", H8300_SIM_STATE(sd)->sim_cache_size);
 
 #ifdef ADEBUG
   /* This to be conditional on `what' (aka `verbose'),
@@ -4838,9 +4997,13 @@ sim_load (SIM_DESC sd, const char *prog, bfd *abfd, int from_tty)
 
   if (h8_get_memory_buf (cpu))
     free (h8_get_memory_buf (cpu));
+  if (h8_get_cache_idx_buf (sd))
+    free (h8_get_cache_idx_buf (sd));
 
   h8_set_memory_buf (cpu, (unsigned char *)
 		     calloc (sizeof (char), memory_size));
+  h8_set_cache_idx_buf (sd, (unsigned short *) 
+			calloc (sizeof (short), memory_size));
   state->memory_size = memory_size;
 
   /* `msize' must be a power of two.  */
