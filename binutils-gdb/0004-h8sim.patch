+static int
+h8_find_symbol_value (bfd *abfd, const char *name, bfd_vma *value)
+{
+  long symcount;
+  asymbol **symbols;
+  long i;
+
+  symcount = bfd_get_symtab_upper_bound (abfd);
+  if (symcount <= 0)
+    return 0;
+
+  symbols = xmalloc (symcount);
+  if (symbols == NULL)
+    return 0;
+
+  symcount = bfd_canonicalize_symtab (abfd, symbols);
+  if (symcount < 0)
+    {
+      free (symbols);
+      return 0;
+    }
+
+  for (i = 0; i < symcount; i++)
+    {
+      if (strcmp (bfd_asymbol_name (symbols[i]), name) == 0)
+        {
+          *value = bfd_asymbol_value (symbols[i]);
+          free (symbols);
+          return 1;
+        }
+    }
+
+  free (symbols);
+  return 0;
+}
+
+static void
+h8_set_stack_pointers (SIM_DESC sd, bfd *abfd)
+{
+  bfd_vma s_top, s_bottom;
+
+  /* Set the default values for stack_top and stack_bottom; they are later
+     used by step_once() to determine whether the code is being executed
+     from the stack or not.  */
+  if (!h8_find_symbol_value (abfd, "__stack", &s_top))
+    {
+      /* Set the default stack top; values 0x2fefc/0xfefc are set by the
+         default ld scripts.  */
+      if ((h8300hmode || h8300smode || h8300sxmode) && !h8300_normal_mode)
+        s_top = 0x2fefc;
+      else
+        s_top = 0xfefc;
+    }
+  H8300_SIM_STATE (sd)->stack_top = (unsigned int) s_top;
+
+  if (!h8_find_symbol_value (abfd, "__end", &s_bottom))
+    {
+      /* Set the default stack size to 1 KiB.  */
+      s_bottom = s_top - 0x400;
+    }
+  else
+    {
+      /* The memory area between __end and __stack is intended for the heap
+         and the stack; reserve half of it for the stack.  */
+      s_bottom = s_top - (s_top - s_bottom) / 2;
+    }
+  H8300_SIM_STATE (sd)->stack_bottom = (unsigned int) s_bottom;
+}
