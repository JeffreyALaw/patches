+static void
+compile (SIM_DESC sd, int pc)
+{
+  int idx;
+
+  /* Find the next cache entry to use.  */
+  idx = h8_get_cache_top (sd) + 1;
+  h8_increment_compiles (sd);
+  if (idx >= H8300_SIM_STATE (sd)->sim_cache_size)
+    {
+      idx = 1;
+    }
+  h8_set_cache_top (sd, idx);
+
+  /* Throw away its old meaning.  */
+  h8_set_cache_idx (sd, H8300_SIM_STATE (sd)->sim_cache[idx].oldpc, 0);
+
+  /* Set to new address.  */
+  H8300_SIM_STATE (sd)->sim_cache[idx].oldpc = pc;
+
+  /* Fill in instruction info.  */
+  decode (sd, STATE_CPU(sd, 0), pc, h8_get_memory_buf (STATE_CPU(sd, 0)) + pc,
+		  H8300_SIM_STATE (sd)->sim_cache + idx);
+
+  /* Point to new cache entry.  */
+  h8_set_cache_idx (sd, pc, idx);
+}
