+static void
+set_simcache_size (SIM_DESC sd, int n)
+{
+  if (H8300_SIM_STATE(sd)->sim_cache)
+    free (H8300_SIM_STATE(sd)->sim_cache);
+  if (n < 2)
+    n = 2;
+  H8300_SIM_STATE(sd)->sim_cache = (decoded_inst *) malloc (sizeof (decoded_inst) * n);
+  memset (H8300_SIM_STATE(sd)->sim_cache, 0, sizeof (decoded_inst) * n);
+  H8300_SIM_STATE(sd)->sim_cache_size = n;
+}
